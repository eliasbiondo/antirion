# Settings for `docker compose` (compose.yaml and compose.cluster.yaml). Copy this file to .env and
# edit the copy; .env is not committed. Every value is optional for compose.yaml.

# The admin bootstrap token: what you paste into the console's "Use an admin token" sign-in, and the
# bearer token of the Admin API. Generate one with:
#   openssl rand -hex 24
# Left empty, the gateway generates one into its volume; read it with:
#   docker compose cp gateway:/var/lib/antirion/data/bootstrap-token - | tar -xO
# The cluster needs one of at least 32 characters.
ANTIRION_BOOTSTRAP_TOKEN=

# The key that seals stored secrets (provider API keys and the like): the base64 of 32 random bytes.
# Generate one with:
#   openssl rand -base64 32
# Keep it: stored secrets cannot be read without it. Left empty, the gateway generates one into its
# volume. The cluster needs one, the same on every node.
ANTIRION_ENCRYPTION_KEY=

# Host ports, published on 127.0.0.1 only: the data plane (the /v1 API your apps call) and the
# admin plane (the Admin API and the console under /ui/).
ANTIRION_DATA_PORT=8080
ANTIRION_ADMIN_PORT=8081

# The address your browser opens the console at. Cookie-authenticated writes from the console must
# come from exactly this origin: change it when you change the admin port, or open the console
# under another host name (127.0.0.1, a LAN name). Default: http://localhost:<ANTIRION_ADMIN_PORT>.
# ANTIRION_PUBLIC_ORIGIN=http://localhost:8081

# The data plane's address as the console shows it in examples. Default:
# http://localhost:<ANTIRION_DATA_PORT>.
# ANTIRION_DATA_PLANE_URL=http://localhost:8080

# Extra flags for `antirion serve`. --test-mode adds the test clock, seed and reset endpoints and
# honours the test-only request headers: for trying things out only, never in production.
# ANTIRION_SERVE_FLAGS=--test-mode

# How compose builds the images. More parallel jobs is faster and needs more memory. The gateway is
# built with thin LTO over 16 codegen units, which fits a Docker VM with a few GiB free; fat and 1
# (the release build) make a slightly faster binary and need several GiB more.
# ANTIRION_BUILD_JOBS=4
# ANTIRION_BUILD_LTO=thin
# ANTIRION_BUILD_CODEGEN_UNITS=16

# The mock upstream's host port (the `mock` profile).
# ANTIRION_MOCK_PORT=19401
